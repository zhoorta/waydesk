[Unit]
Description=waydesk web gateway (the browser client and its bridge to the RDP daemon)
Documentation=file:///usr/share/doc/waydesk/web/README.md
After=network.target waydesk.service waydesk-helper.service
Wants=waydesk.service waydesk-helper.service

[Service]
Type=simple
User=waydesk
Group=waydesk
# The portal's own settings first, then the server's file, which may override them (a portal set up before it had its own file keeps its settings there).
EnvironmentFile=-/etc/default/waydesk-web
EnvironmentFile=-/etc/default/waydesk
# Safe as shipped: this machine only (an SSH tunnel reaches it). WAYDESK_WEB_BIND and WAYDESK_WEB_ALLOW_FROM change that.
ExecStart=/usr/bin/waydesk-web --bind ${WAYDESK_WEB_BIND} --cert /etc/waydesk/cert.pem --key /etc/waydesk/key.pem --target ${WAYDESK_BIND} --root /usr/share/waydesk/web $WAYDESK_WEB_ARGS
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
# The authenticator records (and the record of codes already used) live here: the one place this unit may write. `waydesk-web totp add`, run as root,
# gives the files it makes to the owner of this directory, so the portal can read them.
StateDirectory=waydesk-web
StateDirectoryMode=0700
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# AF_UNIX: the root helper's socket (/run/waydesk/helper.sock), which checks the passwords at sign-in.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
